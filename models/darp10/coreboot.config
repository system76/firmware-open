CONFIG_VENDOR_SYSTEM76=y
CONFIG_BOARD_SYSTEM76_DARP10=y
CONFIG_CCACHE=y
CONFIG_CONSOLE_SERIAL=n
CONFIG_CPU_MICROCODE_CBFS_DEFAULT_BINS=y
CONFIG_HAVE_GBE_BIN=y
CONFIG_GBE_BIN_PATH="$(FIRMWARE_OPEN_MODEL_DIR)/gbe.rom"
CONFIG_HAVE_IFD_BIN=y
CONFIG_IFD_BIN_PATH="$(FIRMWARE_OPEN_MODEL_DIR)/fd.rom"
CONFIG_HAVE_ME_BIN=y
CONFIG_ME_BIN_PATH="$(FIRMWARE_OPEN_MODEL_DIR)/me.rom"
CONFIG_POST_IO=n
CONFIG_SMMSTORE=y
CONFIG_USE_OPTION_TABLE=y
CONFIG_VALIDATE_INTEL_DESCRIPTOR=y

# edk2 payload options
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPOSITORY="https://github.com/system76/edk2"
CONFIG_EDK2_TAG_OR_REV="fcef8a4f805f"
CONFIG_EDK2_BOOTSPLASH_FILE=""
CONFIG_EDK2_BOOT_MANAGER_ESCAPE=y
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
CONFIG_EDK2_GOP_DRIVER=y
CONFIG_EDK2_HAVE_EFI_SHELL=n
CONFIG_EDK2_LOAD_OPTION_ROMS=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_SD_MMC_TIMEOUT=100
CONFIG_EDK2_SECURE_BOOT_SUPPORT=y
CONFIG_EDK2_UEFIPAYLOAD=y
# FIXME: We don't set `EDK2_BOOTSPLASH_FILE` as the logo BMP already modified in our edk2 fork.
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D BOOTSPLASH_IMAGE=TRUE"

# EC debug logging
#CONFIG_CONSOLE_SYSTEM76_EC=y
#CONFIG_EDK2_SYSTEM76_EC_LOGGING=y

# Custom FSP
CONFIG_ADD_FSP_BINARIES=y
CONFIG_FSP_FULL_FD=y
CONFIG_FSP_FD_PATH="$(FIRMWARE_OPEN_MODEL_DIR)/MeteorLakeFspBinPkg/Fsp.fd"
CONFIG_FSP_HEADER_PATH="$(FIRMWARE_OPEN_MODEL_DIR)/MeteorLakeFspBinPkg/Include"
